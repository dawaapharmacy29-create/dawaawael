{
  "name": "PurchaseTargetHistory",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0647\u0631 \u0628\u0635\u064a\u063a\u0629 YYYY-MM"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "target_amount": {
      "type": "number",
      "description": "\u062a\u0627\u0631\u062c\u062a/\u0633\u0642\u0641 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0644\u0634\u0647\u0631\u064a"
    },
    "sales_target_amount": {
      "type": "number",
      "description": "\u062a\u0627\u0631\u062c\u062a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a \u0648\u0642\u062a \u062a\u062b\u0628\u064a\u062a \u0633\u0642\u0641 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a"
    },
    "target_ratio": {
      "type": "number",
      "description": "\u0627\u0644\u0646\u0633\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641\u0629 \u0644\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0645\u0646 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "month",
    "branch",
    "target_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}