{
  "name": "AdminExpenseItem",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0628\u0646\u062f \u0627\u0644\u0645\u0635\u0631\u0648\u0641 (\u0645\u062b\u0644 \u0627\u0644\u0631\u0648\u0627\u062a\u0628\u060c \u0627\u0644\u0625\u064a\u062c\u0627\u0631\u0627\u062a)"
    },
    "notes": {
      "type": "string",
      "description": "\u0648\u0635\u0641 \u0627\u062e\u062a\u064a\u0627\u0631\u064a"
    },
    "start_month": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0644\u064a \u064a\u0628\u062f\u0623 \u0645\u0646\u0647 \u0627\u0644\u0628\u0646\u062f \u064a\u0643\u0648\u0646 \u0645\u0637\u0644\u0648\u0628 (YYYY-MM) \u2014 \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u0627\u064b \u0644\u0648 \u0645\u0637\u0644\u0648\u0628 \u0643\u0644 \u0634\u0647\u0631"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0628\u0646\u062f \u0645\u0641\u0639\u0651\u0644"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0639\u0631\u0636"
    }
  },
  "required": [
    "branch",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}