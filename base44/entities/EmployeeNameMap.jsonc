{
  "name": "EmployeeNameMap",
  "type": "object",
  "properties": {
    "canonical_name": {
      "type": "string",
      "description": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0631\u0633\u0645\u064a \u0627\u0644\u0645\u0637\u0627\u0628\u0642 \u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0623\u0648 \u0627\u0644\u0628\u062f\u064a\u0644\u0629"
    },
    "branch": {
      "type": "string",
      "description": "\u0627\u0644\u0641\u0631\u0639 \u0623\u0648 \u0627\u0644\u0646\u0637\u0627\u0642"
    },
    "admin_staff_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0648\u0638\u0641 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0647\u0644 \u0627\u0644\u0631\u0628\u0637 \u0646\u0634\u0637"
    }
  },
  "required": [
    "canonical_name",
    "admin_staff_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}