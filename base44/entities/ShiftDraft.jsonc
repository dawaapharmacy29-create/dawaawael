{
  "name": "ShiftDraft",
  "type": "object",
  "properties": {
    "draft_key": {
      "type": "string",
      "description": "\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0645\u0633\u0648\u062f\u0629 \u0641\u0631\u0639|\u062a\u0627\u0631\u064a\u062e \u062a\u0634\u063a\u064a\u0644\u064a|\u0646\u0648\u0639 \u0634\u064a\u0641\u062a|\u0645\u0648\u0638\u0641"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "business_date": {
      "type": "string",
      "format": "date",
      "description": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "\u0635\u0628\u0627\u062d\u064a",
        "\u0645\u0633\u0627\u0626\u064a",
        "\u0644\u064a\u0644\u064a"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0634\u064a\u0641\u062a"
    },
    "employee_map_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0631\u0628\u0637 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "total_sales": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0645\u0633\u062c\u0644 \u0641\u064a \u0627\u0644\u0645\u0633\u0648\u062f\u0629"
    },
    "cash_sales": {
      "type": "number",
      "default": 0
    },
    "visa_sales": {
      "type": "number",
      "default": 0
    },
    "insta_sales": {
      "type": "number",
      "default": 0
    },
    "vodafone_sales": {
      "type": "number",
      "default": 0
    },
    "other_sales": {
      "type": "number",
      "default": 0
    },
    "cash_handover": {
      "type": "number",
      "default": 0
    },
    "cash_variance": {
      "type": "number",
      "default": 0
    },
    "visa_terminal_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0642\u064a\u0645\u0629 \u0625\u0642\u0641\u0627\u0644 POS \u0644\u0644\u0641\u064a\u0632\u0627 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0645\u0633\u0648\u062f\u0629"
    },
    "visa_operation_count": {
      "type": "number",
      "default": 0
    },
    "visa_terminal_name": {
      "type": "string"
    },
    "visa_batch_reference": {
      "type": "string"
    },
    "expenses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "payment_source": {
            "type": "string",
            "enum": [
              "cash",
              "insta",
              "vodafone",
              "bank",
              "other"
            ],
            "default": "cash"
          }
        }
      },
      "description": "\u0628\u0646\u0648\u062f \u0627\u0644\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0633\u0648\u062f\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0633\u0648\u062f\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitting",
        "submitted",
        "abandoned"
      ],
      "default": "draft",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0633\u0648\u062f\u0629"
    },
    "last_saved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u062d\u0641\u0638 \u062a\u0644\u0642\u0627\u0626\u064a"
    },
    "submission_token": {
      "type": "string",
      "description": "Token \u062b\u0627\u0628\u062a \u0644\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0648\u0627\u062d\u062f\u0629 \u0644\u0645\u0646\u0639 \u0627\u0644\u0646\u0642\u0631 \u0627\u0644\u0645\u0643\u0631\u0631 \u0645\u0646 \u0627\u0644\u0648\u0627\u062c\u0647\u0629"
    },
    "submitted_shift_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0634\u064a\u0641\u062a \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0628\u0639\u062f \u0627\u0644\u0646\u062c\u0627\u062d"
    },
    "last_error": {
      "type": "string",
      "description": "\u0622\u062e\u0631 \u062e\u0637\u0623 \u0625\u0631\u0633\u0627\u0644 \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u062d\u0627\u0648\u0644\u0627\u062a \u0627\u0644\u0625\u0631\u0633\u0627\u0644"
    }
  },
  "required": [
    "draft_key",
    "branch",
    "business_date",
    "shift_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__no_hard_delete_shift_drafts__"
      }
    }
  }
}