{
  "name": "TargetGoal",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0647\u062f\u0641"
    },
    "target_amount": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641"
    },
    "month": {
      "type": "string",
      "description": "\u0627\u0644\u0634\u0647\u0631 \u0628\u0635\u064a\u063a\u0629 YYYY-MM"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0630\u064a \u064a\u0646\u0637\u0628\u0642 \u0639\u0644\u064a\u0647 \u0627\u0644\u0647\u062f\u0641"
    }
  },
  "required": [
    "target_amount",
    "branch"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}