{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "viewer"
      ],
      "default": "viewer"
    },
    "financial_access_level": {
      "type": "string",
      "enum": [
        "none",
        "limited",
        "full"
      ],
      "default": "none",
      "description": "\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0631\u0624\u064a\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629: \u062a\u0634\u063a\u064a\u0644 \u0641\u0642\u0637 / \u0645\u0627\u0644\u064a \u0645\u062d\u062f\u0648\u062f / \u0645\u0627\u0644\u064a \u0643\u0627\u0645\u0644"
    },
    "branch_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
          "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
        ]
      },
      "description": "\u0627\u0644\u0641\u0631\u0648\u0639 \u0627\u0644\u0645\u0633\u0645\u0648\u062d \u0644\u0644\u062d\u0633\u0627\u0628 \u0628\u0631\u0624\u064a\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0647\u0627 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a\u0629 \u0645\u062b\u0644 \u0633\u062c\u0644 \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0634\u064a\u0641\u062a"
    },
    "can_delete_invoice": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u062d\u0630\u0641 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631",
      "default": false
    },
    "can_save_invoice": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u0642\u062f\u064a\u0645\u0629 \u0644\u0644\u062a\u0648\u0627\u0641\u0642\u061b \u062a\u0633\u062c\u064a\u0644 \u0648\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0623\u0635\u0628\u062d \u062a\u0634\u063a\u064a\u0644\u064b\u0627 \u0645\u062a\u0627\u062d\u064b\u0627 \u0644\u0643\u0644 \u062d\u0633\u0627\u0628",
      "default": false
    },
    "can_manage_team": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u0625\u062f\u0627\u0631\u0629 \u0641\u0631\u064a\u0642 \u0627\u0644\u0639\u0645\u0644",
      "default": false
    },
    "can_set_budget": {
      "type": "boolean",
      "description": "\u0635\u0644\u0627\u062d\u064a\u0629 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a",
      "default": false
    }
  },
  "required": []
}