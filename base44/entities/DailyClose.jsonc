{
  "name": "DailyClose",
  "type": "object",
  "properties": {
    "business_date": {
      "type": "string",
      "format": "date",
      "description": "\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u064a \u0627\u0644\u0630\u064a \u062a\u0645\u062a \u0645\u0631\u0627\u062c\u0639\u062a\u0647"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_review",
        "ready",
        "closed",
        "reopened"
      ],
      "default": "needs_review",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u064a\u0648\u0645\u064a"
    },
    "sales_total": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0648\u0642\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "purchases_total": {
      "type": "number",
      "default": 0,
      "description": "\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0648\u0642\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "expenses_total": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0648\u0642\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "shift_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0634\u064a\u0641\u062a\u0627\u062a \u0627\u0644\u0646\u0634\u0637\u0629"
    },
    "missing_shifts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0634\u064a\u0641\u062a\u0627\u062a \u0627\u0644\u0646\u0627\u0642\u0635\u0629"
    },
    "duplicate_shift_groups": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0634\u064a\u0641\u062a \u0627\u0644\u0645\u0643\u0631\u0631\u0629"
    },
    "review_shift_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0634\u064a\u0641\u062a\u0627\u062a \u062a\u062d\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "anomaly_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0634\u064a\u0641\u062a\u0627\u062a \u0630\u0627\u062a \u0642\u064a\u0645 \u0634\u0627\u0630\u0629 \u0623\u0648 \u0639\u062f\u0645 \u0627\u062a\u0632\u0627\u0646 \u062d\u0633\u0627\u0628\u064a"
    },
    "pending_invoice_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "pending_external_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u0634\u0631\u0627\u0621 \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "pending_internal_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0641\u064a \u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "rejected_invoice_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u0645\u0631\u0641\u0648\u0636\u0629"
    },
    "duplicate_invoice_groups": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u0645\u0634\u062a\u0628\u0647 \u062a\u0643\u0631\u0627\u0631\u0647\u0627"
    },
    "zero_value_invoice_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u0634\u0631\u0627\u0621 \u0627\u0644\u062e\u0627\u0631\u062c\u064a \u0630\u0627\u062a \u0627\u0644\u0642\u064a\u0645\u0629 \u0635\u0641\u0631"
    },
    "quality_issue_count": {
      "type": "number",
      "default": 0,
      "description": "\u0625\u062c\u0645\u0627\u0644\u064a \u0646\u0642\u0627\u0637 \u0627\u0644\u062c\u0648\u062f\u0629 \u0627\u0644\u0645\u0627\u0646\u0639\u0629 \u0644\u0644\u0625\u0642\u0641\u0627\u0644"
    },
    "snapshot_json": {
      "type": "string",
      "description": "\u0644\u0642\u0637\u0629 JSON \u0645\u062e\u062a\u0635\u0631\u0629 \u0644\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629 \u0648\u0642\u062a \u0627\u0644\u0625\u0642\u0641\u0627\u0644"
    },
    "reviewed_by": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0631\u0627\u062c\u0639 \u0627\u0644\u064a\u0648\u0645"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0622\u062e\u0631 \u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "closed_by": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0623\u0642\u0641\u0644 \u0627\u0644\u064a\u0648\u0645"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a"
    },
    "reopened_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0623\u0639\u0627\u062f \u0641\u062a\u062d \u0627\u0644\u064a\u0648\u0645"
    },
    "reopened_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0641\u062a\u062d"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0623\u0648 \u0627\u0644\u0625\u0642\u0641\u0627\u0644"
    }
  },
  "required": [
    "business_date",
    "branch",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__no_hard_delete__"
      }
    }
  }
}