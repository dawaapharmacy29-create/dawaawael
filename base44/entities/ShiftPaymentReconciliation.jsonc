{
  "name": "ShiftPaymentReconciliation",
  "type": "object",
  "properties": {
    "shift_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0634\u064a\u0641\u062a \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ]
    },
    "business_date": {
      "type": "string",
      "format": "date"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "\u0635\u0628\u0627\u062d\u064a",
        "\u0645\u0633\u0627\u0626\u064a",
        "\u0644\u064a\u0644\u064a"
      ]
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "visa",
        "insta",
        "vodafone"
      ],
      "description": "\u0648\u0633\u064a\u0644\u0629 \u0627\u0644\u062a\u062d\u0635\u064a\u0644 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "expected_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0633\u062c\u0644\u0629 \u0641\u064a \u0627\u0644\u0634\u064a\u0641\u062a"
    },
    "terminal_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0642\u064a\u0645\u0629 \u0625\u0642\u0641\u0627\u0644 \u0627\u0644\u062c\u0647\u0627\u0632/\u0627\u0644\u0645\u062d\u0641\u0638\u0629 \u0639\u0646\u062f \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0634\u064a\u0641\u062a"
    },
    "operation_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0625\u0646 \u0643\u0627\u0646 \u0645\u0639\u0631\u0648\u0641\u0627"
    },
    "variance": {
      "type": "number",
      "default": 0,
      "description": "\u0641\u0631\u0642 \u0642\u064a\u0645\u0629 \u0627\u0644\u062a\u062d\u0635\u064a\u0644 \u0639\u0646 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0648\u0633\u064a\u0644\u0629"
    },
    "terminal_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0623\u0648 \u0631\u0642\u0645 \u062c\u0647\u0627\u0632 POS \u0639\u0646\u062f \u0627\u0644\u0641\u064a\u0632\u0627"
    },
    "batch_reference": {
      "type": "string",
      "description": "\u0631\u0642\u0645 Batch \u0623\u0648 \u0645\u0631\u062c\u0639 \u0627\u0644\u0625\u0642\u0641\u0627\u0644"
    },
    "settlement_status": {
      "type": "string",
      "enum": [
        "pending",
        "matched",
        "difference",
        "settled"
      ],
      "default": "pending"
    },
    "settlement_date": {
      "type": "string",
      "format": "date"
    },
    "gross_received": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062a\u064a \u062a\u0645 \u062a\u0633\u0648\u064a\u062a\u0647\u0627 \u0628\u0627\u0644\u0628\u0646\u0643 \u0642\u0628\u0644 \u0627\u0644\u0631\u0633\u0648\u0645"
    },
    "fees": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u0645\u0648\u0644\u0629/\u0631\u0633\u0648\u0645 \u0627\u0644\u062a\u0633\u0648\u064a\u0629"
    },
    "net_received": {
      "type": "number",
      "default": 0,
      "description": "\u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0630\u064a \u062f\u062e\u0644 \u0627\u0644\u0628\u0646\u0643"
    },
    "settlement_variance": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0641\u0631\u0642 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u0648\u0635\u0627\u0641\u064a \u0627\u0644\u062a\u0633\u0648\u064a\u0629 \u0628\u0639\u062f \u0627\u0644\u0631\u0633\u0648\u0645"
    },
    "notes": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "branch",
    "business_date",
    "shift_type",
    "payment_method",
    "expected_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__no_hard_delete_payment_reconciliation__"
      }
    }
  }
}