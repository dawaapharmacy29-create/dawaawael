{
  "name": "MedicineSale",
  "type": "object",
  "properties": {
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "week_label": {
      "type": "string",
      "description": "\u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0623\u0648 \u0627\u0644\u0641\u062a\u0631\u0629"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0623\u0633\u0628\u0648\u0639 \u0623\u0648 \u0627\u0644\u0641\u062a\u0631\u0629"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "sales",
        "balance"
      ],
      "default": "sales",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0633\u062c\u0644: \u0645\u0628\u064a\u0639\u0627\u062a \u0623\u0648 \u0631\u0635\u064a\u062f \u0641\u0639\u0644\u064a"
    },
    "sales": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "medicine_id": {
            "type": "string"
          },
          "medicine_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "balance": {
            "type": "number"
          }
        }
      },
      "description": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0635\u0646\u0641 \u0648\u0627\u0644\u0643\u0645\u064a\u0629 \u0648\u0627\u0644\u0631\u0635\u064a\u062f"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0627\u0644\u0633\u062c\u0644 \u0645\u0624\u0631\u0634\u0641"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archive_reason": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    }
  },
  "required": [
    "branch",
    "week_label",
    "week_start"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__archive_only_no_hard_delete__"
      }
    }
  }
}