{
  "name": "EmployeePermission",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0630\u0646"
    },
    "hours": {
      "type": "number",
      "default": 2,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0633\u0627\u0639\u0627\u062a"
    },
    "type": {
      "type": "string",
      "enum": [
        "\u0633\u0627\u0639\u0629",
        "\u0646\u0635\u0641 \u064a\u0648\u0645",
        "\u064a\u0648\u0645 \u0643\u0627\u0645\u0644"
      ],
      "default": "\u0633\u0627\u0639\u0629",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0625\u0630\u0646"
    },
    "reason": {
      "type": "string",
      "description": "\u0627\u0644\u0633\u0628\u0628"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0628\u0627\u0646\u062a\u0638\u0627\u0631",
        "\u0645\u0648\u0627\u0641\u0642",
        "\u0645\u0631\u0641\u0648\u0636"
      ],
      "default": "\u0645\u0648\u0627\u0641\u0642",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0625\u0630\u0646"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0627\u0644\u0633\u062c\u0644 \u0645\u0624\u0631\u0634\u0641"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archived_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0642\u0627\u0645 \u0628\u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archive_reason": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archive_note": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0629 \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    }
  },
  "required": [
    "employee_name",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__archive_only_no_hard_delete__"
      }
    }
  }
}