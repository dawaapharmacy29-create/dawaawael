{
  "name": "PurchaseInvoice",
  "type": "object",
  "properties": {
    "system_invoice_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c"
    },
    "supplier_invoice_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0645\u0646 \u0627\u0644\u0645\u0648\u0631\u062f \u0623\u0648 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "entered_by": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u062f\u062e\u0644 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "total_value": {
      "type": "number",
      "description": "\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629"
    },
    "returned_value": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u0631\u062a\u062c\u0639",
      "default": 0
    },
    "paid_value": {
      "type": "number",
      "description": "\u0627\u0644\u0645\u062f\u0641\u0648\u0639",
      "default": 0
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "\u0643\u0627\u0634",
        "\u0622\u062c\u0644",
        "\u0627\u0646\u0633\u062a\u0627",
        "\u0641\u0648\u062f\u0627\u0641\u0648\u0646",
        "\u0645\u062e\u062a\u0644\u0637"
      ],
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
        "\u064a\u062a\u0645 \u0627\u0644\u062d\u0641\u0638",
        "\u062a\u0639\u0644\u0642 \u062a\u062d\u062a \u0627\u0644\u062a\u0635\u0631\u064a\u0641"
      ],
      "default": "\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "purchase_category": {
      "type": "string",
      "enum": [
        "medicines",
        "supplies_accessories",
        "unclassified"
      ],
      "default": "unclassified",
      "description": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a: \u0623\u062f\u0648\u064a\u0629 / \u0645\u0633\u062a\u0644\u0632\u0645\u0627\u062a \u0648\u0625\u0643\u0633\u0633\u0648\u0627\u0631 / \u063a\u064a\u0631 \u0645\u0635\u0646\u0641\u0629"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "external_purchase",
        "internal_transfer"
      ],
      "default": "external_purchase",
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u0644\u064a\u0629: \u0634\u0631\u0627\u0621 \u062e\u0627\u0631\u062c\u064a / \u062a\u062d\u0648\u064a\u0644 \u062f\u0627\u062e\u0644\u064a"
    },
    "net_purchase_mode": {
      "type": "string",
      "enum": [
        "inherit",
        "include",
        "exclude"
      ],
      "default": "inherit",
      "description": "\u0637\u0631\u064a\u0642\u0629 \u0627\u062d\u062a\u0633\u0627\u0628 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0641\u064a \u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a: \u0627\u062a\u0628\u0627\u0639 \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0648\u0631\u062f / \u0645\u062d\u062a\u0633\u0628\u0629 / \u0645\u0633\u062a\u062b\u0646\u0627\u0629"
    },
    "exclusion_reason": {
      "type": "string",
      "enum": [
        "internal_transfer",
        "not_actual_purchase",
        "tracking_only",
        "excluded_supplier",
        "settlement",
        "duplicate_review",
        "other"
      ],
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0645\u0646 \u0635\u0627\u0641\u064a \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a"
    },
    "exclusion_note": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062b\u0646\u0627\u0621"
    },
    "excluded_by": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0630\u064a \u0646\u0641\u0630 \u0627\u0644\u0627\u0633\u062a\u062b\u0646\u0627\u0621"
    },
    "excluded_at": {
      "type": "string",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0648\u0648\u0642\u062a \u0627\u0644\u0627\u0633\u062a\u062b\u0646\u0627\u0621"
    },
    "source_branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0645\u0635\u062f\u0631 (\u0644\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629)"
    },
    "destination_branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0645\u0633\u062a\u0644\u0645 (\u0644\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629)"
    },
    "cash_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639 \u0643\u0627\u0634 (\u0644\u0644\u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u0645\u062e\u062a\u0644\u0637\u0629)"
    }
  },
  "required": [
    "system_invoice_number",
    "total_value",
    "payment_type",
    "status",
    "branch"
  ],
  "rls": {
