{
  "name": "SupplierDebtAdjustment",
  "type": "object",
  "properties": {
    "supplier_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "amount": {
      "type": "number",
      "description": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0641\u0631\u0642 \u2014 \u0645\u0648\u062c\u0628 \u064a\u0632\u0648\u0651\u062f \u0627\u0644\u0645\u062f\u064a\u0648\u0646\u064a\u0629\u060c \u0633\u0627\u0644\u0628 \u064a\u0642\u0644\u0651\u0644\u0647\u0627"
    },
    "adjustment_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0641\u0631\u0642"
    },
    "notes": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0641\u0631\u0642\u060c \u0645\u062b\u0644\u0627\u064b: \u0641\u0627\u062a\u0648\u0631\u0629 \u0633\u0642\u0637\u062a \u0633\u0647\u0648\u0627\u064b \u0645\u0646 \u0627\u0644\u0645\u0648\u0638\u0641"
    }
  },
  "required": [
    "supplier_name",
    "branch",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
