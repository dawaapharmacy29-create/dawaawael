{
  "name": "ManagementLoginDirectory",
  "type": "object",
  "properties": {
    "login_username": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0638\u0627\u0647\u0631 \u0644\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u0645\u0648\u062d\u062f"
    },
    "admin_staff_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0648\u0638\u0641 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "management_account_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 staff_accounts \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0625\u062f\u0627\u0631\u0629"
    },
    "display_name": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "management_role": {
      "type": "string"
    },
    "base44_user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u062d\u0633\u0627\u0628 Base44 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 \u0625\u0646 \u0643\u0627\u0646 \u0645\u0624\u0643\u062f\u0627\u064b"
    },
    "base44_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u062d\u0633\u0627\u0628 Base44 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 \u0625\u0646 \u0643\u0627\u0646 \u0645\u0624\u0643\u062f\u0627\u064b"
    },
    "financial_access_level": {
      "type": "string",
      "enum": [
        "none",
        "limited",
        "full"
      ],
      "default": "none"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "login_username",
    "admin_staff_id",
    "display_name",
    "financial_access_level",
    "is_active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}