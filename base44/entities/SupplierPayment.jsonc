{
  "name": "SupplierPayment",
  "type": "object",
  "properties": {
    "supplier_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "invoice_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "invoice_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "amount": {
      "type": "number",
      "description": "\u0645\u0628\u0644\u063a \u0627\u0644\u062d\u0631\u0643\u0629 \u0628\u0627\u0644\u0645\u0648\u062c\u0628\u061b \u0646\u0648\u0639 \u0627\u0644\u062d\u0631\u0643\u0629 \u064a\u062d\u062f\u062f \u0623\u062b\u0631\u0647\u0627"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "branch": {
      "type": "string",
      "description": "\u0627\u0644\u0641\u0631\u0639 \u0627\u0644\u0645\u0633\u062f\u062f \u0639\u0644\u064a\u0647"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "\u0643\u0627\u0634",
        "\u062a\u062d\u0648\u064a\u0644 \u0628\u0646\u0643\u064a",
        "\u0627\u0646\u0633\u062a\u0627",
        "\u0641\u0648\u062f\u0627\u0641\u0648\u0646",
        "\u0634\u064a\u0643",
        "\u0623\u062e\u0631\u0649"
      ],
      "description": "\u0648\u0633\u064a\u0644\u0629 \u0627\u0644\u0633\u062f\u0627\u062f"
    },
    "reference_number": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0623\u0648 \u0627\u0644\u0645\u0631\u062c\u0639 \u0623\u0648 \u0627\u0644\u0634\u064a\u0643"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "payment",
        "reversal",
        "adjustment"
      ],
      "default": "payment",
      "description": "\u0646\u0648\u0639 \u062d\u0631\u0643\u0629 \u062f\u0641\u062a\u0631 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "status": {
      "type": "string",
      "enum": [
        "posted",
        "reversed"
      ],
      "default": "posted",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0631\u0643\u0629"
    },
    "reversal_of_payment_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0639\u0646\u062f \u062a\u0633\u062c\u064a\u0644 \u0639\u0643\u0633 \u062d\u0631\u0643\u0629"
    },
    "allocation_type": {
      "type": "string",
      "enum": [
        "invoice",
        "general",
        "multi_invoice"
      ],
      "default": "general",
      "description": "\u0646\u0648\u0639 \u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u062f\u0641\u0639\u0629"
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string"
          },
          "invoice_number": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "description": "\u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u062f\u0641\u0639\u0629 \u0639\u0644\u0649 \u0641\u0627\u062a\u0648\u0631\u0629 \u0623\u0648 \u0623\u0643\u062b\u0631"
    },
    "allocation_sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "applied",
        "needs_review",
        "not_applicable"
      ],
      "default": "not_applicable",
      "description": "\u062d\u0627\u0644\u0629 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0648\u0632\u064a\u0639 \u0639\u0644\u0649 paid_value \u0644\u0644\u0641\u0648\u0627\u062a\u064a\u0631"
    },
    "allocation_sync_error": {
      "type": "string",
      "description": "\u0622\u062e\u0631 \u062e\u0637\u0623 \u0623\u062b\u0646\u0627\u0621 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0648\u0632\u064a\u0639 \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0627\u062a\u064a\u0631"
    },
    "recorded_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0633\u062c\u0644 \u0627\u0644\u062d\u0631\u0643\u0629"
    },
    "approved_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0627\u0639\u062a\u0645\u062f \u0627\u0644\u062d\u0631\u0643\u0629"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f"
    }
  },
  "required": [
    "supplier_name",
    "amount",
    "payment_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.can_save_invoice": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "data.can_save_invoice": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__no_hard_delete_financial_ledger__"
      }
    }
  }
}