{
  "name": "EmployeeLoan",
  "type": "object",
  "properties": {
    "employee_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "amount": {
      "type": "number",
      "description": "\u0645\u0628\u0644\u063a \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "installments_count": {
      "type": "number",
      "default": 1,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0623\u0642\u0633\u0627\u0637"
    },
    "monthly_deduction": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0642\u0633\u0637 \u0627\u0644\u0634\u0647\u0631\u064a"
    },
    "paid_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062f\u062f"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0646\u0634\u0637\u0629",
        "\u0645\u0643\u062a\u0645\u0644\u0629",
        "\u0645\u0644\u063a\u0627\u0629"
      ],
      "default": "\u0646\u0634\u0637\u0629",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0627\u0644\u0633\u062c\u0644 \u0645\u0624\u0631\u0634\u0641"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0648\u0642\u062a \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archived_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0642\u0627\u0645 \u0628\u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archive_reason": {
      "type": "string",
      "description": "\u0633\u0628\u0628 \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "archive_note": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0629 \u0627\u0644\u0623\u0631\u0634\u0641\u0629"
    },
    "status_before_archive": {
      "type": "string",
      "description": "\u0627\u0644\u062d\u0627\u0644\u0629 \u0642\u0628\u0644 \u0627\u0644\u0623\u0631\u0634\u0641\u0629 \u0644\u0627\u0633\u062a\u0639\u0627\u062f\u062a\u0647\u0627 \u0644\u0627\u062d\u0642\u064b\u0627"
    }
  },
  "required": [
    "employee_name",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__server_verified_only__"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__archive_only_no_hard_delete__"
      }
    }
  }
}