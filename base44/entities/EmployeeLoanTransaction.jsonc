{
  "name": "EmployeeLoanTransaction",
  "type": "object",
  "properties": {
    "loan_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0633\u0644\u0641\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629"
    },
    "employee_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "branch": {
      "type": "string",
      "enum": [
        "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
        "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
      ],
      "description": "\u0627\u0644\u0641\u0631\u0639"
    },
    "transaction_date": {
      "type": "string",
      "format": "date",
      "description": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0631\u0643\u0629"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "installment",
        "payment",
        "adjustment_plus",
        "adjustment_minus",
        "reversal"
      ],
      "description": "\u0646\u0648\u0639 \u062d\u0631\u0643\u0629 \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "amount": {
      "type": "number",
      "description": "\u0642\u064a\u0645\u0629 \u0627\u0644\u062d\u0631\u0643\u0629 \u0628\u0627\u0644\u0645\u0648\u062c\u0628"
    },
    "reference_transaction_id": {
      "type": "string",
      "description": "\u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u0639\u0643\u0633"
    },
    "payroll_month": {
      "type": "string",
      "description": "\u0634\u0647\u0631 \u0627\u0644\u0645\u0631\u062a\u0628 YYYY-MM \u0625\u0630\u0627 \u0643\u0627\u0646 \u062e\u0635\u0645 \u0645\u0631\u062a\u0628"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "recorded_by": {
      "type": "string",
      "description": "\u0645\u0646 \u0633\u062c\u0644 \u0627\u0644\u062d\u0631\u0643\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "posted",
        "reversed"
      ],
      "default": "posted",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0631\u0643\u0629"
    }
  },
  "required": [
    "loan_id",
    "employee_name",
    "transaction_date",
    "transaction_type",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "__no_hard_delete_financial_ledger__"
      }
    }
  }
}