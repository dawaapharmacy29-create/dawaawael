{
  "name": "OperationalAccessPolicy",
  "type": "object",
  "properties": {
    "policy_key": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "policy_key",
    "is_active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}