{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0636\u0648"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "\u062f\u0648\u0627\u0621 \u0634\u0643\u0631\u064a",
          "\u062f\u0648\u0627\u0621 \u0627\u0644\u0634\u0627\u0645\u064a"
        ]
      },
      "description": "\u0627\u0644\u0641\u0631\u0648\u0639"
    },
    "role": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0631 / \u0627\u0644\u0645\u0646\u0635\u0628"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
    },
    "annual_leave_entitlement": {
      "type": "number",
      "default": 21,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0625\u062c\u0627\u0632\u0627\u062a \u0627\u0644\u0633\u0646\u0648\u064a\u0629 (\u0623\u064a\u0627\u0645)"
    },
    "permission_hours_entitlement": {
      "type": "number",
      "default": 24,
      "description": "\u0631\u0635\u064a\u062f \u0627\u0644\u0625\u0630\u0648\u0646\u0627\u062a \u0627\u0644\u0633\u0646\u0648\u064a\u0629 (\u0633\u0627\u0639\u0627\u062a)"
    }
  },
  "required": [
    "name",
    "branches"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "viewer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    }
  }
}