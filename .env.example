# Base44 legacy runtime (temporary during migration)
VITE_BASE44_APP_ID=
VITE_BASE44_FUNCTIONS_VERSION=
VITE_BASE44_APP_BASE_URL=

# Supabase target project
VITE_SUPABASE_URL=https://zqfsakrxazznkqnjlgzv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Data provider mode: base44 | shadow | supabase
# base44: existing behavior only
# shadow: Base44 remains primary while writes are mirrored/audited in Supabase
# supabase: Supabase becomes the primary provider after reconciliation
VITE_DATA_PROVIDER=base44
